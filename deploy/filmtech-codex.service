[Unit]
Description=FilmTechNews private Codex text adapter
After=network-online.target docker.service mihomo.service
Wants=network-online.target mihomo.service

[Service]
Type=simple
WorkingDirectory=/opt/filmtechnews
EnvironmentFile=/opt/filmtechnews/.codex-bridge.env
Environment=CODEX_BINARY=/usr/local/bin/codex
Environment=CODEX_BRIDGE_TIMEOUT_MS=300000
ExecStart=/usr/local/bin/node /opt/filmtechnews/scripts/codex-bridge.mjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=330
NoNewPrivileges=true
PrivateTmp=true
# Tencent currently runs systemd 219; strict and ReadWritePaths are unsupported.
ProtectSystem=full
ProtectHome=read-only
ReadWriteDirectories=/root/.codex /opt/filmtechnews/.data

[Install]
WantedBy=multi-user.target
